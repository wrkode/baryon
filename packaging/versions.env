# Pinned host components of the Baryon-enabled Hadron image. One place for
# versions and checksums; read by packaging/hadron/Dockerfile (as build
# arguments) and hack/fetch-artifacts.sh.

HADRON_IMAGE=ghcr.io/kairos-io/hadron:v0.5.3
KAIROS_INIT_IMAGE=quay.io/kairos/kairos-init:v4.3.0
# Kubernetes provider installed by kairos-init. k0s is the tested
# distribution of v0.1 (docs/compatibility.md); k3s is kept for builds of
# the earlier single-node configuration and is not supported.
K0S_VERSION=v1.36.4+k0s.1
K3S_VERSION=v1.36.4+k3s1

CLOUD_HYPERVISOR_VERSION=v53.0
CLOUD_HYPERVISOR_URL=https://github.com/cloud-hypervisor/cloud-hypervisor/releases/download/v53.0/cloud-hypervisor-static
CLOUD_HYPERVISOR_SHA256=448af3d4e59b22c2987f7df94c213ad40fb53a10d437e42b5ee6c4fce7c29ecc

CLOUDHV_FIRMWARE_RELEASE=ch-97eeb7b09
CLOUDHV_FIRMWARE_URL=https://github.com/cloud-hypervisor/edk2/releases/download/ch-97eeb7b09/CLOUDHV.fd
CLOUDHV_FIRMWARE_SHA256=dc2fc8f0e43b96712d9fccc52a3a590769606412b3e1bc911d217addd3bef624

VIRTIOFSD_VERSION=v1.14.0
VIRTIOFSD_ZIP_URL=https://gitlab.com/-/project/21523468/uploads/f505704014ae7a816e515f2a05a93d8b/virtiofsd-v1.14.0.zip
VIRTIOFSD_ZIP_SHA256=2e4fe9571f492b00baa34bc4e708e950039c5da05b830b31a8d179cb6ac8978e
VIRTIOFSD_SHA256=15b2e72a78cc08a9bd8a6943e89fb69c88cb3cbeb63069efceade835342ac7d4
